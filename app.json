{
  "expo": {
    "scheme": "scalebodyfinder",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/scale-body-finder"
    },
    "name": "Scale Body Finder",
    "slug": "scale-body-finder",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mmi.scalebodyfinder"
    },
    "android": {
      "package": "com.mmi.scalebodyfinder",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
