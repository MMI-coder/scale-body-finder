{
  "name": "scale-body-finder",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "data": "node tools/build-body-data.js && node tools/build-glossary.js",
    "verify": "node tools/verify-matching.js",
    "prestart": "npm run data",
    "start": "expo start",
    "preandroid": "npm run data",
    "android": "expo start --android",
    "preios": "npm run data",
    "ios": "expo start --ios",
    "preweb": "npm run data",
    "web": "expo start --web",
    "prebuild:web": "npm run data",
    "build:web": "expo export --platform web",
    "glossary": "node tools/build-glossary.js --preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
