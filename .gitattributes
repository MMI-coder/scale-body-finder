# The CI deploy regenerates data/bodies.js and fails if it differs from the
# committed copy. That check compares bytes, so these two files must not have
# their line endings rewritten differently on Windows and Linux.
data/bodies.js text eol=lf
data/glossary.js text eol=lf
data/bodies.csv text eol=lf

# Never touch the product photos.
*.jpg binary
*.png binary
*.xlsx binary
